# 本地 Ollama 服务地址
OLLAMA_BASE_URL=http://localhost:11434
# ollama.com 账号 API key（免费账号可申请；不填或失效时自动降级到本地 Ollama 服务的 experimental 端点，需本机 Ollama 已登录账号）
OLLAMA_API_KEY=
# 选题 Agent 模型（provider=ollama 时生效，小模型提速）
SELECT_MODEL=qwen3.5:9b
# 写作 SubAgent 模型（provider=ollama 时生效，大模型保质量）
WRITE_MODEL=qwen3.8:latest
# 选题 Agent 模型提供商：ollama（本地）或 deepseek（云端 API）
SELECT_PROVIDER=ollama
# 写作 SubAgent 模型提供商：ollama（本地）或 deepseek（云端 API）
WRITE_PROVIDER=ollama
# DeepSeek API（当任一 provider=deepseek 时必填）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 模型名：deepseek-v4-flash / deepseek-chat / deepseek-reasoner 等（以你的账号可用为准）
DEEPSEEK_MODEL=deepseek-v4-flash
# 选题模型上下文（实测 system 提示+8个工具schema+top-30候选≈7.4k tokens，需留推理与输出余量）
SELECT_NUM_CTX=16384
# 写作模型上下文（联网搜索结果较长，建议 >= 32768）
WRITE_NUM_CTX=32768
# 选题温度（稳定）
SELECT_TEMPERATURE=0.2
# 写作温度（创造性）
WRITE_TEMPERATURE=0.7
# 写作最大生成 token 数
NUM_PREDICT=4096
# 输入 RSS 聚合文件（相对项目根目录，不存在则报错退出）
RSS_FILE=sample/2026-09-03_tech_rss.json
# 博客输出目录（相对项目根目录，自动创建）
OUTPUT_DIR=output
# deepagents thread_id
THREAD_ID=news-blog
# 热点新闻输入文件（热点 Agent：选 2 则最有价值新闻，各生成一篇热点解读 md）
HOTSPOTS_FILE=sample/2026-09-03_news_hotspots.json
# 热点 Agent 的 deepagents thread_id
HOTSPOT_THREAD_ID=news-hotspots
# 可选：LangSmith 追踪（有值则启用）
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=

# ---- 本地联网服务（SearXNG + Crawl4AI，替代 ollama.com 的 web_search/web_fetch）----
# 封装层地址（searxng-crawl4ai 项目的 api 服务）
LOCAL_WEB_BASE_URL=http://127.0.0.1:8000
# docker-compose.yml 绝对路径：cli.py 用它自动 up / stop
LOCAL_WEB_COMPOSE_FILE=D:\project\private\new_life\code\local_flow\searxng-crawl4ai\docker-compose.yml
# 1=运行前自动启动容器、跑完自动停止；0=不管容器，直接用现有服务
LOCAL_WEB_AUTOSTART=1
# 1=跑完不停止容器（调试用）
LOCAL_WEB_KEEPALIVE=0
# 封装层若设了 API_TOKEN，这里填同一个值
LOCAL_WEB_API_TOKEN=
# 启动等待上限（秒）
LOCAL_WEB_START_TIMEOUT=150
# 可选：本地服务不可用时回退到 Ollama 云端联网（额度已用完，默认关闭）
WEB_TOOLS_OLLAMA_FALLBACK=0
# 选题 token 调优（可选，默认已压缩）
# SELECT_TOP_N=20
# SELECT_SUMMARY_LIMIT=120
# SELECT_HOTSPOT_TOP_N=18

# 选题是否深度思考：none=省 token（默认），medium/high=更充分但更贵
# SELECT_REASONING_EFFORT=none
